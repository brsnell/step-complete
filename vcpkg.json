{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "step-complete",
  "version-semver": "0.1.0",
  "description": "Cross-platform STEP viewer with measurement and PMI",
  "license": "MIT",
  "builtin-baseline": "80aae04504a834399456d74605204bfe514762bf",
  "dependencies": [
    "zlib",
    {
      "name": "opencascade",
      "default-features": false,
      "features": [ "freetype" ]
    }
  ],
  "overrides": [
    { "name": "opencascade", "version": "8.0.1" }
  ],
  "features": {
    "tests": {
      "description": "Unit tests",
      "dependencies": [ "gtest" ]
    },
    "qt": {
      "description": "Qt from vcpkg instead of an official Qt install, so a build needs only a compiler, CMake and vcpkg (Visual Studio 2022 ships all three)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui", "widgets", "opengl", "testlib", "concurrent", "thread",
            "freetype", "harfbuzz", "png", "pcre2", "doubleconversion",
            { "name": "fontconfig", "platform": "linux" },
            { "name": "xcb", "platform": "linux" },
            { "name": "xcb-xlib", "platform": "linux" },
            { "name": "xrender", "platform": "linux" },
            { "name": "egl", "platform": "linux" }
          ]
        }
      ]
    }
  }
}
